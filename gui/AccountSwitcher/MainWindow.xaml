<Window x:Class="AccountSwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Account Switcher"
        Icon="pack://application:,,,/app.ico"
        Width="540" Height="660" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen">

  <Window.Resources>
    <BooleanToVisibilityConverter x:Key="Visible" />

    <Style x:Key="Secondary" TargetType="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="Card" TargetType="Border">
      <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
    </Style>

    <Style x:Key="Chip" TargetType="Border">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="7,2" />
      <Setter Property="Margin" Value="0,0,6,0" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
      <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="ActiveChip" TargetType="Border" BasedOn="{StaticResource Chip}">
      <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
    </Style>
  </Window.Resources>

  <Grid Margin="20,16,20,14">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Accounts" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Style="{StaticResource Secondary}" Margin="0,2,0,0"
                 Text="Pick an account for the Claude app and the Claude CLI." />
    </StackPanel>

    <!-- What each one is signed in as right now. -->
    <Grid Grid.Row="1" Margin="0,0,0,14">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="10" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}" Padding="12,9">
        <StackPanel>
          <TextBlock Style="{StaticResource Secondary}" Text="Claude app" />
          <TextBlock x:Name="AppNow" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource Card}" Padding="12,9">
        <StackPanel>
          <TextBlock Style="{StaticResource Secondary}" Text="Claude CLI" />
          <TextBlock x:Name="CliNow" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,0" />
        </StackPanel>
      </Border>
    </Grid>

    <ScrollViewer x:Name="ListArea" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <ItemsControl x:Name="AccountList">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,8">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Width="38" Height="38" CornerRadius="19" VerticalAlignment="Center" Margin="0,0,12,0"
                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                  <TextBlock Text="{Binding Initial}" FontSize="16" FontWeight="SemiBold"
                             HorizontalAlignment="Center" VerticalAlignment="Center"
                             Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                             ToolTip="{Binding Name}" />
                  <TextBlock Style="{StaticResource Secondary}" Text="{Binding Subtitle}"
                             Visibility="{Binding HasSubtitle, Converter={StaticResource Visible}}" />
                  <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Border Style="{StaticResource ActiveChip}" Visibility="{Binding AppActive, Converter={StaticResource Visible}}">
                      <TextBlock Text="App: in use" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding AppSaved, Converter={StaticResource Visible}}">
                      <TextBlock Text="App: saved" FontSize="11" />
                    </Border>
                    <Border Style="{StaticResource ActiveChip}" Visibility="{Binding CliActive, Converter={StaticResource Visible}}">
                      <TextBlock Text="CLI: in use" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                    </Border>
                    <Border Style="{StaticResource Chip}" Visibility="{Binding CliSaved, Converter={StaticResource Visible}}">
                      <TextBlock Text="CLI: saved" FontSize="11" />
                    </Border>
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                  <Button Content="{Binding SwitchLabel}" Tag="{Binding}" Click="OnSwitch"
                          Style="{DynamicResource AccentButtonStyle}" MinWidth="84"
                          ToolTip="{Binding SwitchHint}"
                          Visibility="{Binding CanSwitch, Converter={StaticResource Visible}}" />
                  <Button Content="⋯" Tag="{Binding}" Click="OnRowMenu" Margin="6,0,0,0" Width="36"
                          ToolTip="More options" AutomationProperties.Name="More options" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

    <!-- Shown in place of the list until there is something in it. -->
    <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center"
                MaxWidth="340" Visibility="Collapsed">
      <TextBlock Text="No accounts yet" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" />
      <TextBlock Style="{StaticResource Secondary}" TextWrapping="Wrap" TextAlignment="Center" Margin="0,6,0,0"
                 Text="Sign in to the Claude app or the Claude CLI and the account shows up here. Use Add account for each extra one." />
    </StackPanel>

    <ProgressBar x:Name="Busy" Grid.Row="3" IsIndeterminate="True" Height="3" Margin="0,6,0,0" Visibility="Hidden" />

    <Grid Grid.Row="4" Margin="0,8,0,0">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <TextBlock x:Name="Status" Style="{StaticResource Secondary}" TextWrapping="Wrap" TextTrimming="None"
                 Margin="0,0,0,8" Visibility="Collapsed" />
      <DockPanel Grid.Row="1" LastChildFill="False">
        <Button x:Name="AddButton" Content="Add account" Click="OnAdd" DockPanel.Dock="Left" />
        <Button x:Name="MoreButton" Content="More" Click="OnMore" DockPanel.Dock="Right" Margin="6,0,0,0" />
        <Button x:Name="RefreshButton" Content="Refresh" Click="OnRefresh" DockPanel.Dock="Right" />
      </DockPanel>
    </Grid>
  </Grid>
</Window>
